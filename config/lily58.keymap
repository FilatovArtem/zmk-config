#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        enter_or_numlayer: enter_or_numlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "ENTER_OR_NUMLAYER";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_code_macos {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC        &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                                                    &kp N6    &kp N7         &kp N8        &kp N9   &kp N0    &kp BSPC
&kp TAB        &kp Q   &kp W   &kp E      &kp R     &kp T                                                     &kp Y     &kp U          &kp I         &kp O    &kp P     &kp BSLH
&kp LC(SPACE)  &kp A   &kp S   &kp D      &kp F     &kp G                                                     &kp H     &kp J          &kp K         &kp L    &kp SEMI  &kp APOS
&kp LSHFT      &kp Z   &kp X   &kp C      &kp V     &kp B     &kp LEFT_BRACKET    &kp RIGHT_BRACKET           &kp N     &kp M          &kp COMMA     &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE           &enter_or_numlayer 2 ENTER  &kp RGUI  &kp BACKSPACE  &kp CAPSLOCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        qwerty_code_linux {
            bindings = <
&kp ESC        &kp N1  &kp N2  &kp N3        &kp N4    &kp N5                                                     &kp N6    &kp N7         &kp N8        &kp N9   &kp N0    &kp BACKSPACE
&kp TAB        &kp Q   &kp W   &kp E         &kp R     &kp T                                                      &kp Y     &kp U          &kp I         &kp O    &kp P     &kp BACKSLASH
&kp LC(SPACE)  &kp A   &kp S   &kp D         &kp F     &kp G                                                      &kp H     &kp J          &kp K         &kp L    &kp SEMI  &kp APOS
&kp LSHFT      &kp Z   &kp X   &kp C         &kp V     &kp B      &kp LEFT_BRACKET    &kp RIGHT_BRACKET           &kp N     &kp M          &kp COMMA     &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LEFT_WIN  &kp LALT  &kp LCTRL  &kp SPACE           &enter_or_numlayer 2 ENTER  &kp RGUI  &kp BACKSPACE  &kp CAPSLOCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navigation_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &kp F7    &kp F8         &kp F9       &kp F10    &kp F11          &kp F12
&to 3   &none   &kp N7  &kp N8  &kp N9  &none                     &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp PRINTSCREEN  &none
&to 0   &none   &kp N4  &kp N5  &kp N6  &none                     &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none            &none
&none   &kp N0  &kp N1  &kp N2  &kp N3  &none   &none     &none   &none     &none          &none        &none      &none            &none
                        &none   &none   &none   &trans    &trans  &none     &none          &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        f_layer {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LC(UP_ARROW)  &kp LG(SPACE)  &none   &kp K_SLEEP                    &kp C_PAUSE  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&to 3                 &none                 &none             &none          &none   &bt BT_NXT                     &kp F7       &kp F8            &kp F9      &kp F10     &kp F11            &kp F12
&to 2                 &none                 &none             &none          &none   &bt BT_PRV                     &kp F1       &kp F2            &kp F3      &kp F4      &kp F5             &kp F6
&trans                &none                 &none             &none          &none   &bt BT_CLR   &none     &none   &trans       &none             &none       &none       &none              &trans
                                                              &trans         &trans  &trans       &trans    &trans  &trans       &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        kpPRESS_or_toHOLD: kpPRESS_or_toHOLD {
            compatible = "zmk,behavior-hold-tap";
            label = "KPPRESS_OR_TOHOLD";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_code_macos {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kpPRESS_or_toHOLD 1 NUMBER_1  &kpPRESS_or_toHOLD 2 NUMBER_2  &kpPRESS_or_toHOLD 3 NUMBER_3  &kp N4    &kp N5                                           &kp N6    &kp N7         &kp N8        &kp N9   &kpPRESS_or_toHOLD 0 N0  &kp BSPC
&kp TAB    &kp Q                          &kp W                          &kp E                          &kp R     &kp T                                            &kp Y     &kp U          &kp I         &kp O    &kp P                    &kp BSLH
&kp GRAVE  &kp A                          &kp S                          &kp D                          &kp F     &kp G                                            &kp H     &kp J          &kp K         &kp L    &kp SEMI                 &kp APOS
&kp LSHFT  &kp Z                          &kp X                          &kp C                          &kp V     &kp B     &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N     &kp M          &kp COMMA     &kp DOT  &kp FSLH                 &kp RSHFT
                                                                         &kp LCTRL                      &kp LALT  &kp LGUI  &kp SPACE           &kp ENTER          &kp RGUI  &kp BACKSPACE  &kp CAPSLOCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        qwerty_code_linux {
            bindings = <
&trans         &trans  &trans  &trans     &trans    &trans                                           &trans    &trans         &trans        &trans   &trans    &trans
&kp TAB        &kp Q   &kp W   &kp E      &kp R     &kp T                                            &kp Y     &kp U          &kp I         &kp O    &kp P     &kp BSLH
&kp LC(SPACE)  &kp A   &kp S   &kp D      &kp F     &kp G                                            &kp H     &kp J          &kp K         &kp L    &kp SEMI  &kp APOS
&kp LSHFT      &kp Z   &kp X   &kp C      &kp V     &kp B     &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N     &kp M          &kp COMMA     &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE           &kp ENTER          &kp RGUI  &kp BACKSPACE  &kp CAPSLOCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navigation_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans     &trans           &trans
&none   &none   &kp N7  &kp N8  &kp N9  &none                     &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp PRINTSCREEN  &none
&none   &none   &kp N4  &kp N5  &kp N6  &none                     &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none            &none
&none   &kp N0  &kp N1  &kp N2  &kp N3  &none   &none     &none   &none     &none          &none        &none      &none            &none
                        &trans  &trans  &trans  &trans    &trans  &none     &none          &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        f_layer {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans   &trans   &trans
&none   &none   &none   &none   &none   &bt BT_NXT                    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none   &none   &none   &none   &none   &bt BT_PRV                    &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&none   &none   &none   &none   &none   &bt BT_CLR  &none     &none   &trans  &none   &none   &none    &none    &trans
                        &trans  &trans  &trans      &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
